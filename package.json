{
  "name": "polyframes",
  "version": "2.1.0",
  "description": "Polybar window/frame label renderer for herbstluftwm — bunli CLI, compiled to a standalone native binary",
  "type": "module",
  "bin": {
    "polyframes": "src/index.ts"
  },
  "scripts": {
    "dev": "bunli dev",
    "build": "bunli build",
    "test": "bun test tests/render.test.ts",
    "test:live": "sh scripts/live.guard.sh && POLYFRAMES_LIVE_TESTS=1 bun test tests/integration.test.ts"
  },
  "dependencies": {
    "@bunli/core": "^0.8.2",
    "herbstutil": "^0.3.1",
    "zod": "^4",
    "herbctl": "github:akinevz2/herbctl"
  },
  "devDependencies": {
    "@oven/bun-linux-x64": "^1.4.4",
    "@types/bun": "latest",
    "bunli": "^0.8.2",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "trustedDependencies": [
    "bun",
    "herbctl",
    "herbstutil"
  ]
}
